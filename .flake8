[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    migrations,
    node_modules,
    .pytest_cache,
    .coverage,
    htmlcov,
    .tox,
    .cache,
    *.pyc,
    *.pyo,
    *.pyd,
    .Python,
    *.so,
    .coverage,
    .pytest_cache,
    .DS_Store,
    .vscode,
    .idea
per-file-ignores =
    __init__.py:F401
max-complexity = 10
import-order-style = google
application-import-names = app