# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_automation
POSTGRES_DB=legal_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Ollama AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b
OLLAMA_TIMEOUT=120

# WAHA WhatsApp Configuration
WAHA_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key-here
WAHA_SESSION=default

# File Monitoring Configuration
WATCH_FOLDER_1=D:/Download Legalitas
WATCH_FOLDER_2=D:/Documents/Legal/Queue

# Google Drive Configuration
GOOGLE_DRIVE_CREDENTIALS_FILE=./config/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-root-folder-id

# Logging Configuration
LOG_LEVEL=INFO

# Service URLs
AI_PROCESSOR_URL=http://localhost:8002
VALIDATION_URL=http://localhost:8003
DRIVE_SERVICE_URL=http://localhost:8004
NOTIFICATION_URL=http://localhost:8005

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8001
REACT_APP_WS_URL=ws://localhost:8001

# Monitoring Configuration
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Development Configuration
NODE_ENV=development
PYTHONPATH=/app