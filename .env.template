# Database Configuration
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=legal_automation

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Ollama Configuration
OLLAMA_MODEL=llama3:70b
OLLAMA_TIMEOUT=120

# WhatsApp WAHA Configuration
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default

# Google Drive Configuration
GOOGLE_CLIENT_SECRETS_FILE=./services/google-drive/secrets/client_secrets.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./services/google-drive/secrets/service_account.json
ENABLE_VIRUS_SCAN=false

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring Configuration
GRAFANA_PASSWORD=admin

# Application Environment
NODE_ENV=development

# File Watching Configuration
WATCH_FOLDER_1=./watched
WATCH_FOLDER_2=./queue